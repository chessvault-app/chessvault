# Copy to scripts/deploy.env (gitignored) and fill in. Nothing about one
# person's server belongs in a tracked file, which is why this example
# exists and the real thing never gets committed.
#
# Only CHESS_VAULT_HOST is required; everything else has a default that
# matches the layout in README.md.

# Where the server is. Keep SSH off the public internet — the reference
# deployment reaches the box over a Tailscale tailnet with port 22 closed.
CHESS_VAULT_HOST=ubuntu@your-host

# SSH key. Omit entirely to use whatever your ssh-agent already holds.
#CHESS_VAULT_KEY=~/.ssh/your-key.pem

# The checkout deploy.sh updates, and the systemd unit it restarts.
#CHESS_APP_DIR=/srv/chess-vault-app
#CHESS_SERVICE=chess-vault

# The vault on the SERVER, which backup-vault.sh pulls down. Deliberately
# not CHESS_VAULT_DIR: that one is read by the app on this machine, and a
# local dev setting must not be able to redirect a backup.
#CHESS_SERVER_VAULT=/srv/chess-vault

# Only for self-hosting the desktop update feed. Releases go to GitHub, so
# release.sh no longer uploads installers anywhere and neither of these is
# read unless build.publish in package.json is pointed back at `generic`.
# CHESS_VAULT_UPDATES is the SERVER process's setting (where /updates
# serves from — server/paths.ts); CHESS_UPDATE_URL is read by the shell.
#CHESS_VAULT_UPDATES=/srv/chess-vault-updates
#CHESS_UPDATE_URL=https://your-host/updates
