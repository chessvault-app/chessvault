{
  "name": "chess-vault",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "the Chess Vault authors",
  "version": "0.9.5",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "A private, offline-first chess vault: analysis, opening explorer, studies, notes and puzzles.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chessvault-app/chessvault"
  },
  "scripts": {
    "predev": "npm run setup:engine",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "setup:engine": "tsx scripts/setup-engine.ts",
    "dev:server": "node --import tsx --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "prebuild": "npm run setup:engine",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint web/src",
    "check:repo": "tsx scripts/check-repo.ts",
    "verify": "npm run lint && npm run check:repo && npm run typecheck && npm test",
    "build:openings": "tsx scripts/build-openings.ts",
    "build:puzzles": "tsx scripts/build-puzzles.ts",
    "build:refgames": "tsx scripts/build-refgames.ts",
    "tune:dbs": "tsx scripts/tune-dbs.ts",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "check:tablebase": "tsx scripts/tablebase-parity.ts",
    "build:native-goldens": "tsx scripts/export-native-goldens.ts",
    "desktop": "electron desktop/main.mjs",
    "desktop:package": "node desktop/build-server.mjs && npm run build && electron-builder --win nsis",
    "desktop:release": "bash scripts/release.sh",
    "desktop:package:mac": "node desktop/build-server.mjs && npm run build && electron-builder --mac dmg",
    "build:demo": "tsx scripts/build-demo-seed.ts && vite build --config web/vite.demo.config.ts",
    "build:demo-dbs": "tsx scripts/build-demo-dbs.ts",
    "build:bundled-refgames": "tsx scripts/build-bundled-refgames.ts",
    "build:site": "npm run build:demo && tsx scripts/build-landing.ts",
    "shots": "electron --force-device-scale-factor=1 scripts/capture-screenshots.mjs",
    "shots:gif": "node scripts/record-demo-gif.mjs",
    "shots:social": "node scripts/render-social-card.mjs",
    "desktop:package:linux": "node desktop/build-server.mjs && npm run build && electron-builder --linux AppImage deb",
    "fuzz:parity": "tsx scripts/fuzz-parity.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "shots:grid": "tsx scripts/shot-grid.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@lichess-org/chessground": "^10.1.1",
    "@lichess-org/stockfish-web": "^0.5.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^13.0.3",
    "chessops": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "fzstd": "^0.1.1",
    "hono": "^4.13.7",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.3.289",
    "pretendard": "^1.3.9",
    "prosemirror-markdown": "^1.13.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "stockfish": "^18.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "gifenc": "^1.0.3",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true,
    "stockfish@18.0.8": true
  },
  "build": {
    "appId": "io.riovault.chess",
    "productName": "Chess Vault",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "desktop/**/*",
      "!desktop/build-server.mjs",
      "!desktop/README.md",
      "!node_modules/**/*",
      "node_modules/argparse/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*"
    ],
    "extraResources": [
      {
        "from": "release/server",
        "to": "server"
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "scripts/vendor/chess-openings",
        "to": "scripts/vendor/chess-openings"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "chessvault-app",
      "repo": "chessvault",
      "releaseType": "draft"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Chess-Vault-Setup.${ext}",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Chess-Vault-${arch}.${ext}",
      "icon": "desktop/icon-1024.png",
      "category": "public.app-category.games",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Chess-Vault-${arch}.${ext}",
      "icon": "desktop/icon.png",
      "category": "Game",
      "synopsis": "Your chess, in plain files",
      "maintainer": "the Chess Vault authors <chessvault-app@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "Chess Vault"
        }
      }
    },
    "afterPack": "desktop/after-pack.mjs"
  },
  "main": "desktop/main.mjs"
}
