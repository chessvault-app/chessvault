{
  "name": "chess-vault",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.2.3",
  "type": "module",
  "description": "A private, offline-first chess vault: analysis, opening explorer, studies, notes and puzzles.",
  "scripts": {
    "predev": "npm run setup:engine",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "setup:engine": "tsx scripts/setup-engine.ts",
    "dev:server": "node --import tsx --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "prebuild": "npm run setup:engine",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:openings": "tsx scripts/build-openings.ts",
    "build:book": "tsx scripts/build-book.ts",
    "build:puzzles": "tsx scripts/build-puzzles.ts",
    "build:refgames": "tsx scripts/build-refgames.ts",
    "tune:dbs": "tsx scripts/tune-dbs.ts",
    "desktop": "electron desktop/main.mjs",
    "desktop:package": "node desktop/build-server.mjs && npm run build && electron-builder --win nsis",
    "desktop:release": "bash scripts/release.sh",
    "desktop:package:mac": "node desktop/build-server.mjs && npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lichess-org/chessground": "^10.1.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^13.0.3",
    "chessops": "^0.15.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "hono": "^4.13.0",
    "lucide-react": "^1.28.0",
    "markdown-it": "^15.0.0",
    "pdfjs-dist": "^6.2.108",
    "prosemirror-markdown": "^1.13.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish": "^18.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true,
    "stockfish@18.0.8": true
  },
  "build": {
    "appId": "io.riovault.chess",
    "productName": "Chess Vault",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "desktop/**/*",
      "!desktop/build-server.mjs",
      "!desktop/README.md",
      "!node_modules/**/*",
      "node_modules/argparse/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*"
    ],
    "extraResources": [
      {
        "from": "release/server",
        "to": "server"
      },
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "${env.CHESS_UPDATE_URL}"
    },
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "desktop/icon.png",
      "category": "public.app-category.games",
      "identity": null
    }
  },
  "main": "desktop/main.mjs"
}
