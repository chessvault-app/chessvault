node_modules/
dist/

# Derived, rebuildable artefacts. Safe to delete; regenerate with the
# `build:*` scripts.
data/
web/public/engine/

# The vault is USER DATA — games, notes, studies, config (holds API
# tokens), imported books. It is never committed: the server creates the
# skeleton on boot, and book content extracted from commercial PDFs must
# not be redistributed. Its fine-grained history lives inside it as
# .history.git (auto-committed by server/vaultBackup.ts).
vault/*
!vault/.gitkeep

# Local copies pulled from the server by scripts/backup-vault.sh.
vault-backups/

# Editor and agent scaffolding: whose machine runs what, not how the app
# works. .claude/launch.json names a dev command and a port, which every
# contributor already gets from package.json. skills-lock.json is the
# `skills` CLI's record of what it copied into .claude/skills — the shadcn
# skill, per CLAUDE.md — and belongs with it.
.claude/
skills-lock.json

.DS_Store
*.log

# pdf.js decoders staged by setup-engine — derived, rebuildable.
web/public/pdfjs-wasm/

__pycache__/
release/

# Cargo build output for the native pipeline crate.
native/target/

# Personal deploy target (host, key) — never committed.
scripts/deploy.env

# Desktop release artefacts, built and uploaded rather than committed.
updates/

# Static demo build output (rebuildable from demo-seed/).
dist-demo/
dist-site/

# The starter reference games that ship inside an installer. Derived like
# everything in data/, and built by the desktop workflow at release time —
# see the `starter-db` job in .github/workflows/desktop.yml. Build one
# locally with `npm run build:bundled-refgames` if you are packaging by hand.
assets/*.sqlite
