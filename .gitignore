node_modules/
dist/

# Derived, rebuildable artefacts. Safe to delete; regenerate with the
# `build:*` scripts.
data/
web/public/engine/

# The vault is USER DATA — games, notes, studies, config (holds API
# tokens), imported books. It is never committed: the server creates the
# skeleton on boot, and book content extracted from commercial PDFs must
# not be redistributed. Its fine-grained history lives inside it as
# .history.git (auto-committed by server/vaultBackup.ts).
vault/*
!vault/.gitkeep

# Local copies pulled from the server by scripts/backup-vault.sh.
vault-backups/

.DS_Store
*.log

# pdf.js decoders staged by setup-engine — derived, rebuildable.
web/public/pdfjs-wasm/

__pycache__/
release/
